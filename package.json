{
  "name": "piagent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:adapters": "npm run build && node --test --test-concurrency=1 tests/adapters.integration.mjs",
    "start": "node packages/piagent-daemon/dist/cli.js",
    "probe": "node packages/piagent-daemon/dist/adapter-probe.js",
    "omp:smoke": "node scripts/omp-smoke.mjs",
    "package": "npm run build && node scripts/package-core.mjs",
    "package:adapters": "npm run build && node scripts/package-core.mjs --adapters"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
