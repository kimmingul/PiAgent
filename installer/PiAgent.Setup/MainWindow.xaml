<Window x:Class="PiAgent.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PiAgent 설치" Width="650" Height="660" MinWidth="600" MinHeight="610" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="PiAgent" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Architecture" Margin="0,8,0,16" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1" x:Name="Options">
      <GroupBox Header="설치할 IDE 선택" Padding="14" Margin="0,0,0,12"><StackPanel>
        <CheckBox IsChecked="True" IsEnabled="False" Content="PiAgent Core (필수)" Margin="0,0,0,10"/>
        <CheckBox x:Name="Rad32" Content="RAD Studio 13.2 — 32비트 IDE" Margin="0,0,0,10"/>
        <CheckBox x:Name="Rad64" Content="RAD Studio 13.2 — 64비트 IDE" Margin="0,0,0,10"/>
        <CheckBox x:Name="Vs22" Content="Visual Studio 2022" Margin="0,0,0,10"/>
        <CheckBox x:Name="Vs26" Content="Visual Studio 2026"/>
      </StackPanel></GroupBox>
      <GroupBox Header="OMP" Padding="14" Margin="0,0,0,12"><StackPanel>
        <TextBlock x:Name="OmpStatus" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <CheckBox x:Name="InstallOmp" Content="OMP 함께 설치 (공식 최신 버전 다운로드)"/>
      </StackPanel></GroupBox>
      <TextBlock Text="Node.js와 .NET 런타임은 설치파일에 포함됩니다. IDE와 OMP 로그인 정보, 저장된 대화는 유지합니다. 설치 전에 선택한 IDE를 종료해주세요." TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock x:Name="Location" TextWrapping="Wrap" Foreground="DimGray"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,8" Visibility="Collapsed" IsIndeterminate="True"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="InstallButton" Content="설치" IsDefault="True" MinWidth="96" Padding="14,7" Click="InstallClick"/>
        <Button x:Name="CloseButton" Content="닫기" IsCancel="True" MinWidth="96" Padding="14,7" Margin="10,0,0,0" Click="CloseClick"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
