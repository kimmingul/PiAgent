<Window x:Class="PiAgent.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PiAgent" Width="680" Height="750" MinWidth="650" MinHeight="720" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel><TextBlock Text="PiAgent" FontSize="28" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="LanguageChoice" Width="115" VerticalAlignment="Center" AutomationProperties.Name="Language / 언어" SelectionChanged="LanguageChanged"><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="Architecture" Margin="0,8,0,16" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="Options">
      <GroupBox x:Name="IdeGroup" Padding="14" Margin="0,0,0,12"><StackPanel>
        <CheckBox x:Name="CoreChoice" IsChecked="True" IsEnabled="False" Margin="0,0,0,10"/>
        <CheckBox x:Name="Rad32" Margin="0,0,0,10"/>
        <CheckBox x:Name="Rad64" Margin="0,0,0,10"/>
        <CheckBox x:Name="Vs22" Content="Visual Studio 2022" Margin="0,0,0,10"/>
        <CheckBox x:Name="Vs26" Content="Visual Studio 2026"/>
      </StackPanel></GroupBox>
      <GroupBox Header="OMP" Padding="14" Margin="0,0,0,12"><StackPanel>
        <TextBlock x:Name="OmpStatus" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <CheckBox x:Name="InstallOmp"/>
      </StackPanel></GroupBox>
      <TextBlock x:Name="InstallHelp" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock x:Name="Location" TextWrapping="Wrap" Foreground="DimGray"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,8" Visibility="Collapsed" IsIndeterminate="True"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="InstallButton" IsDefault="True" MinWidth="96" Padding="14,7" Click="InstallClick"/>
        <Button x:Name="CloseButton" IsCancel="True" MinWidth="96" Padding="14,7" Margin="10,0,0,0" Click="CloseClick"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
