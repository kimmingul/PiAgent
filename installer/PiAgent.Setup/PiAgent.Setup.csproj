<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PiAgent-Setup</AssemblyName><Version>0.9.20</Version>
    <ApplicationIcon>../../adapters/radstudio/resources/RADAgent.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="$(PayloadArchive)" LogicalName="PiAgent.Payload.zip" Condition="'$(PayloadArchive)' != ''" /></ItemGroup>
</Project>
