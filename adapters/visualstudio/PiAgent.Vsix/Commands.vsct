    <Groups><Group guid="guidCommands" id="ConnectionGroup" priority="0x0600"><Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" /></Group></Groups>
    <Buttons><Button guid="guidCommands" id="CheckConnection" priority="0x0100" type="Button"><Parent guid="guidCommands" id="ConnectionGroup"/><Strings><ButtonText>PiAgent: Check Core Connection</ButtonText></Strings></Button>
    <Button guid="guidCommands" id="OpenChat" priority="0x0101" type="Button"><Parent guid="guidCommands" id="ConnectionGroup"/><Icon guid="guidIcons" id="ChatIcon"/><Strings><ButtonText>PiAgent: Open Chat</ButtonText></Strings></Button>    <Button guid="guidCommands" id="CompleteCode" priority="0x0102" type="Button"><Parent guid="guidCommands" id="ConnectionGroup"/><Strings><ButtonText>PiAgent: Suggest Code / 코드 제안</ButtonText></Strings></Button>
