  PiAgent.TestResults in 'PiAgent.TestResults.pas',
  PiAgent.TestArguments in 'PiAgent.TestArguments.pas',
  PiAgent.IdeTests in 'PiAgent.IdeTests.pas',
  PiAgent.DesignerAcceptance in 'PiAgent.DesignerAcceptance.pas',
  PiAgent.DesignerJournal in 'PiAgent.DesignerJournal.pas',
  PiAgent.DesignerAuthoring in 'PiAgent.DesignerAuthoring.pas',
  PiAgent.BuildDiagnostics in 'PiAgent.BuildDiagnostics.pas',
  PiAgent.BuildCommand in 'PiAgent.BuildCommand.pas',
  PiAgent.OwnedProcess in 'PiAgent.OwnedProcess.pas',
  PiAgent.ExternalBuild in 'PiAgent.ExternalBuild.pas',
  PiAgent.ProjectIdentity in 'PiAgent.ProjectIdentity.pas',
  PiAgent.EditorOffsets in 'PiAgent.EditorOffsets.pas',
  PiAgent.EditorSuggestions in 'PiAgent.EditorSuggestions.pas',
  PiAgent.IdeDebug in 'PiAgent.IdeDebug.pas',
  PiAgent.IdeContext in 'PiAgent.IdeContext.pas',
  PiAgent.IdeBuild in 'PiAgent.IdeBuild.pas',
  PiAgent.IdeHost in 'PiAgent.IdeHost.pas',
  PiAgent.CoreRuntime in 'PiAgent.CoreRuntime.pas',
  PiAgent.MenuIcon in 'PiAgent.MenuIcon.pas',
  PiAgent.DesignerRelations in 'PiAgent.DesignerRelations.pas',
  PiAgent.DesignerAuthoringGuards in 'PiAgent.DesignerAuthoringGuards.pas',
  PiAgent.IdeSoak in 'PiAgent.IdeSoak.pas',
  PiAgent.CoreAcceptance in 'PiAgent.CoreAcceptance.pas',
  PiAgent.Designer in 'PiAgent.Designer.pas',
  PiAgent.PipeClient in 'PiAgent.PipeClient.pas',
  PiAgent.ChatWorker in 'PiAgent.ChatWorker.pas',
  PiAgent.ChatForm in 'PiAgent.ChatForm.pas',
  PiAgent.Wizard in 'PiAgent.Wizard.pas';
